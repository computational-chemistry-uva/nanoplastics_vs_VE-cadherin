# unit: kcal / mol
UNITS ENERGY=kcal/mol

# defining COM separation
c1: COM ATOMS=1-1689
c2: COM ATOMS=1690-3378
d1: DISTANCE ATOMS=c1,c2

# fixed restraint continuing the existing window at its target (fresh-start extension:
# step counter resets to 0, so the original MOVINGRESTRAINT's absolute STEP0/STEP1
# would never trigger -- hold constant at AT1 from step 0 instead)
RESTRAINT ARG=d1 AT=3.37 KAPPA=500.0

# printing out collective variables
PRINT STRIDE=500 ARG=* FILE=colvars/COLVAR_3.37
